{
  "compilerOptions": {
    "module": "esnext",
    "target": "es2022",
    "moduleResolution": "node",
    "checkJs": false,
    "baseUrl": ".",
    "allowSyntheticDefaultImports": true,
    "paths": {
      "@/*": [
        "src/*"
      ]
    }
  },
  "include": [
    "src/**/*.js",
    "tests/**/*.js",
    "src/**/*",
    "tests/**/*",
    "wdio.conf.js",
  ],
  "exclude": [
    "node_modules",
    "reports"
  ]
}