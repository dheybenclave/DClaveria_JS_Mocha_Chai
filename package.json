{
  "name": "DClaveria_JS_Mocha_Chai",
  "version": "1.0.0",
  "description": "Web and API Automation Framework using WebDriverIO, Mocha, and Chai",
  "type": "module",
  "scripts": {
    "test": "wdio run ./config/wdio.local.conf.js --openMochawesomeReport=true --maxInstances=10",
    "test:parallel": "wdio run ./config/wdio.local.conf.js --openMochawesomeReport=true --maxInstances=10",
    "test:chrome": "wdio run ./config/wdio.local.conf.js --capabilities.chrome",
    "test:firefox": "wdio run ./config/wdio.local.conf.js --capabilities.firefox",
    "test:api": "wdio run ./config/wdio.local.conf.js --specs ./src/specs/api/**/*.spec.js --openMochawesomeReport=true --maxInstances=10",
    "test:web": "wdio run ./config/wdio.local.conf.js --specs ./src/specs/web/**/*.spec.js --openMochawesomeReport=true --maxInstances=10",
    "test:tag": "wdio run ./config/wdio.local.conf.js --suite regression --mochaOpts.grep=\"%npm_config_tag%\" --openMochawesomeReport=true --maxInstances=10",
    "test:ci": "wdio run ./config/wdio.ci.conf.js --suite regression",
    "test:web:tag": "wdio run ./config/wdio.local.conf.js --specs ./src/specs/web/**/*.spec.js --mochaOpts.grep=\"%npm_config_tag%\" --openMochawesomeReport=true --maxInstances=10",
    "test:api:tag": "wdio run ./config/wdio.local.conf.js --specs ./src/specs/api/**/*.spec.js --mochaOpts.grep=\"%npm_config_tag%\" --openMochawesomeReport=true --maxInstances=10",
    "wdio": "wdio run ./config/wdio.local.conf.js",
    "collect": "npx wdio run ./config/wdio.local.conf.js --suite regression --dry-run",
    "report": "start ./reports/mochawesome.html",
    "pipeline": "npm run agentic:bootstrap && npm run collect && npm run test:tag --tag=@tc_1 && npm run test:tag --tag=@e2e_1 && npm run report",
    "agentic:bootstrap": "node .kilo/scripts/bootstrap.js",
    "agentic:heal": "node .kilo/scripts/heal.js",
    "agentic:generate": "node .kilo/scripts/generate.js",
    "generate-html": "marge ./reports/test-report.json --reportDir ./reports --reportFilename index.html"
  },
  "keywords": [
    "webdriverio",
    "mocha",
    "chai",
    "automation",
    "e2e"
  ],
  "author": "Dheo Claveria",
  "license": "MIT",
  "devDependencies": {
    "@wdio/cli": "^9.30.0",
    "@wdio/globals": "^9.29.1",
    "@wdio/local-runner": "^9.30.0",
    "@wdio/mocha-framework": "^9.30.0",
    "@wdio/spec-reporter": "^9.29.1",
    "eslint": "^9.0.0",
    "eslint-plugin-wdio": "^9.0.0",
    "mochawesome": "^7.1.4",
    "mochawesome-merge": "^5.1.1",
    "mochawesome-report-generator": "^6.3.2",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "wdio-mochawesome-reporter": "^7.0.0"
  },
  "dependencies": {
    "chai": "^5.0.0",
    "dotenv": "^16.6.1"
  }
}